FROM gradle:8.5-jdk21 AS builder  
  
# Redeclarar ARG en este stage (los ARG no se heredan entre stages)  
ARG SPRING_PROFILES_ACTIVE=prod  
  
WORKDIR /app  
  
# Copiar archivos de dependencias primero (cache layer)  
COPY build.gradle settings.gradle ./  
COPY gradle ./gradle  
  
# Descargar dependencias (cacheado si no cambian)  
RUN gradle dependencies --no-daemon || true  
  
# Copiar el resto del código  
COPY . .  
  
# Compilar con el perfil activo  
RUN gradle bootJar \  
    -Pspring.profiles.active=${SPRING_PROFILES_ACTIVE} \  
    --no-daemon \  
    -x test

# Stage 2

FROM eclipse-temurin:21-jre-alpine AS runtime  
  
# Redeclarar ARG para este stage  
ARG SPRING_PROFILES_ACTIVE=prod  
  
# Exponer como ENV para que Spring Boot lo lea en runtime  
ENV SPRING_PROFILES_ACTIVE=${SPRING_PROFILES_ACTIVE}  
  
WORKDIR /app  
  
# Copiar solo el JAR generado desde el stage anterior  
COPY --from=builder /app/build/libs/*.jar app.jar  
  
EXPOSE 8080  
  
ENTRYPOINT ["java", "-jar", "app.jar"]